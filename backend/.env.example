# Copie este archivo como .env y ajuste los valores
SECRET_KEY=genere-una-clave-larga-y-aleatoria
DATABASE_URL=postgresql+psycopg://copropiedad:clave@localhost:5432/copropiedad
NOMBRE_CONJUNTO=Conjunto Avellana Ciudad Verde
NIT_CONJUNTO=900.000.000-0
CORS_ORIGINS=https://portal.miconjunto.co
TOKEN_MINUTOS=480

# Correo (opcional). Si se deja vacío, las notificaciones solo aparecen en el portal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
